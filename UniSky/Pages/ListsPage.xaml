<Page
    x:Class="UniSky.Pages.ListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:lists="using:UniSky.ViewModels.Lists"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded">

    <Page.Resources>
        <DataTemplate x:Key="ListItemTemplate" x:DataType="lists:UserListViewModel">
            <Button Style="{ThemeResource CleanButtonStyle}" Command="{Binding OpenListCommand}">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Margin="0,0,12,0"
                            Background="{ThemeResource SystemAccentColorDark1}">
                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"
                                   MaxLines="2"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarPadding" Height="0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBackground"
                    Grid.RowSpan="2"
                    Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                    extensions:Hairline.BorderThickness="1,0,1,1"/>
            <Border Grid.Row="1" Padding="{ThemeResource GenericPageHeaderMargin}">
                <Grid>
                    <TextBlock x:Uid="ListsPageTitleBlock"
                               Margin="12,4,12,12"
                               Text="LISTS"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BaseTextBlockStyle}"/>
                    <Button x:Name="NewListButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,8"
                            Style="{ThemeResource ButtonRevealStyle}"
                            Background="Transparent"
                            AutomationProperties.Name="New list"
                            ToolTipService.ToolTip="New list"
                            Click="NewListButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <SymbolIcon Symbol="Add"/>
                            <TextBlock Text="New list" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <ListView x:Name="RootList"
                  Grid.Row="1"
                  Style="{StaticResource FeedListViewStyle}"
                  ItemsSource="{x:Bind ViewModel.Lists, Mode=OneWay}"
                  ItemTemplate="{StaticResource ListItemTemplate}"/>

        <Grid x:Name="NoItemsGrid"
              x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
              Grid.Row="1"
              MaxWidth="600"
              Margin="24,80,24,0"
              VerticalAlignment="Top"
              HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE71D;"
                       FontSize="48"
                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="No lists yet"
                           TextWrapping="Wrap"
                           Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Lists you create will appear here."
                           Style="{ThemeResource BodyTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <ProgressBar Grid.Row="1"
                     MaxWidth="600"
                     VerticalAlignment="Top"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Background="Transparent"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0,0,0,1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="621"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0,1,1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
