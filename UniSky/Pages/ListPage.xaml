<Page
    x:Class="UniSky.Pages.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:lists="using:UniSky.ViewModels.Lists"
    xmlns:profiles="using:UniSky.ViewModels.Profile"
    Loaded="Page_Loaded">

    <Page.Resources>
        <DataTemplate x:Key="MemberTemplate" x:DataType="profiles:ProfileViewModel">
            <Button Style="{ThemeResource CleanButtonStyle}" Command="{Binding OpenProfileCommand}">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="42" Height="42" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Handle}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarPadding" Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBackground"
                    Grid.RowSpan="3"
                    Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                    extensions:Hairline.BorderThickness="1,0,1,1"/>
            <TextBlock Grid.Row="1"
                       Margin="24,8,24,4"
                       Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2"
                       Margin="24,0,24,12"
                       Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"/>
        </Grid>

        <ListView x:Name="RootList"
                  Grid.Row="1"
                  Style="{StaticResource FeedListViewStyle}"
                  ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}"
                  ItemTemplate="{StaticResource MemberTemplate}"/>

        <ProgressBar Grid.Row="1"
                     MaxWidth="600"
                     VerticalAlignment="Top"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Background="Transparent"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0,0,0,1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="621"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0,1,1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
