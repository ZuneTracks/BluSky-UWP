<Page
    x:Class="UniSky.Pages.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:lists="using:UniSky.ViewModels.Lists"
    xmlns:converters="using:UniSky.Converters"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>

        <DataTemplate x:Key="MemberTemplate" x:DataType="lists:ListMemberViewModel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <Button Style="{ThemeResource CleanButtonStyle}" Command="{Binding OpenProfileCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="42" Height="42" Margin="0,0,12,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Style="{ThemeResource BaseTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Handle}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
                <Button Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="Remove"
                        Command="{Binding RemoveCommand}"
                        Visibility="{Binding CanRemove, Converter={StaticResource VisibilityConverter}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuggestionTemplate" x:DataType="lists:ActorSuggestion">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="32" Height="32" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Bind AvatarUrl}"/>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Status}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarPadding" Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderBackground"
                    Grid.RowSpan="4"
                    Grid.ColumnSpan="2"
                    Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                    extensions:Hairline.BorderThickness="1,0,1,1"/>
            <TextBlock Grid.Row="1"
                       Margin="24,8,24,4"
                       Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2"
                       Margin="24,0,24,12"
                       Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                       Grid.ColumnSpan="2"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"/>
            <StackPanel x:Name="OwnerActions"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,16,4"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Visibility="{x:Bind ViewModel.IsOwner, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                <Button x:Name="EditListButton"
                        Click="EditListButton_Click"
                        ToolTipService.ToolTip="Edit list"
                        AutomationProperties.Name="Edit list"
                        Style="{ThemeResource ButtonRevealStyle}"
                        Background="Transparent">
                    <SymbolIcon Symbol="Edit"/>
                </Button>
                <Button x:Name="DeleteListButton"
                        Click="DeleteListButton_Click"
                        ToolTipService.ToolTip="Delete list"
                        AutomationProperties.Name="Delete list"
                        Style="{ThemeResource ButtonRevealStyle}"
                        Background="Transparent"
                        Margin="4,0,0,0">
                    <SymbolIcon Symbol="Delete"/>
                </Button>
            </StackPanel>
            <AutoSuggestBox x:Name="AddMemberBox"
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Margin="24,0,24,12"
                            PlaceholderText="Add people by name or handle"
                            QueryIcon="AddFriend"
                            ItemTemplate="{StaticResource SuggestionTemplate}"
                            Visibility="{x:Bind ViewModel.IsOwner, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                            TextChanged="AddMemberBox_TextChanged"
                            SuggestionChosen="AddMemberBox_SuggestionChosen"
                            QuerySubmitted="AddMemberBox_QuerySubmitted"/>
        </Grid>

        <ListView x:Name="RootList"
                  Grid.Row="1"
                  Style="{StaticResource FeedListViewStyle}"
                  ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}"
                  ItemTemplate="{StaticResource MemberTemplate}"/>

        <ProgressBar Grid.Row="1"
                     MaxWidth="600"
                     VerticalAlignment="Top"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Background="Transparent"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0,0,0,1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="621"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0,1,1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
