<Page
    x:Class="UniSky.Pages.FeedsListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniSky.Pages"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:viewmodels="using:UniSky.ViewModels"
    xmlns:feeds="using:UniSky.ViewModels.Feeds"
    xmlns:controls="using:UniSky.Controls"
    xmlns:converters="using:UniSky.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:w1709="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 5)"
    xmlns:w1803="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 6)"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    w1803:KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>
    </Page.Resources>

    <Grid x:Name="RootPage">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarPadding" Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBackground"
                Grid.RowSpan="2"
                MaxWidth="600"
                Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                extensions:Hairline.BorderThickness="1,0,1,1"/>

        <Border Grid.Row="1"
                Padding="{ThemeResource GenericPageHeaderMargin}"
                MaxWidth="600">
            <TextBlock x:Uid="FeedsListPageTitleBlock"
                       Margin="12,4,12,12"
                       Text="FEEDS"
                       Style="{ThemeResource BaseTextBlockStyle}"/>
        </Border>

        <Grid Grid.Row="2" MaxWidth="600">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24,20,24,40" w1709:Spacing="12">
                    <TextBlock Text="SAVED FEEDS" Style="{ThemeResource BaseTextBlockStyle}"/>
                    <TextBlock Text="Pinned feeds appear as tabs on your home timeline. Unpinned feeds stay saved here."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="You have not saved any custom feeds yet."
                               Visibility="{x:Bind ViewModel.HasSavedFeeds, Mode=OneWay, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"
                               Style="{ThemeResource BodyTextBlockStyle}"/>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.SavedFeeds, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="feeds:FeedGeneratorViewModel">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Description}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Text="{x:Bind Creator}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="PINNED"
                                                   Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.OpenFeedCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="{x:Bind PinLabel, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.TogglePinCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding DataContext.RemoveFeedCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ADD A FEED" Margin="0,16,0,0" Style="{ThemeResource BaseTextBlockStyle}"/>
                    <TextBox PlaceholderText="Paste a Bluesky feed link or at:// URI"
                             Text="{x:Bind ViewModel.CustomFeedUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Save feed" HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.AddCustomFeedCommand}"/>

                    <TextBlock Text="FIND FEEDS" Margin="0,16,0,0" Style="{ThemeResource BaseTextBlockStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="Search feeds"
                                 InputScope="Search"
                                 KeyDown="SearchBox_KeyDown"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Search" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.SearchCommand}"/>
                        <Button Grid.Column="2" Content="Clear" Margin="8,0,0,0"
                                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                                Command="{x:Bind ViewModel.ClearSearchCommand}"/>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.DiscoverHeader, Mode=OneWay}" Margin="0,8,0,0" Style="{ThemeResource BaseTextBlockStyle}"/>
                    <TextBlock Text="No feeds matched your search."
                               Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                               Style="{ThemeResource BodyTextBlockStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestedFeeds, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="feeds:FeedGeneratorViewModel">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Description}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock Text="{x:Bind Creator}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open" Margin="12,0,0,0"
                                            Command="{Binding DataContext.OpenFeedCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="Save" Margin="8,0,0,0"
                                            Command="{Binding DataContext.SaveFeedCommand, ElementName=RootPage}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                                  HorizontalAlignment="Center"/>
                    <Button Content="Load more" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasMoreFeeds, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"
                            Command="{x:Bind ViewModel.LoadMoreCommand}"/>
                </StackPanel>
            </ScrollViewer>

            <controls:LoadErrorControl Title="Failed to load feeds"
                                       Error="{x:Bind ViewModel.Error, Mode=OneWay}"
                                       RetryCommand="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"/>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="621" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
