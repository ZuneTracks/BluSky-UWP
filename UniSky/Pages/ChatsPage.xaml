<Page
    x:Class="UniSky.Pages.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Windows.UI.Xaml.Automation"
    xmlns:chats="using:UniSky.ViewModels.Chats"
    xmlns:controls="using:UniSky.Controls"
    xmlns:converters="using:UniSky.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:w1709="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 5)"
    xmlns:w1803="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 6)"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    w1803:KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter"/>

        <DataTemplate x:Key="ChatMessageTemplate"
                      x:DataType="chats:ChatMessageViewModel">
            <Grid Padding="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SenderLabel}"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                <TextBlock Text="{Binding Text}"
                           Grid.Row="1"
                           Margin="0,2,0,0"
                           TextWrapping="WrapWholeWords"
                           Style="{ThemeResource BodyTextBlockStyle}"/>
                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           Text="{Binding Timestamp}"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <w1709:Page.KeyboardAccelerators>
        <w1709:KeyboardAccelerator Key="F5"
                                   Invoked="RefreshAccelerator_Invoked"/>
    </w1709:Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarPadding" Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBackground"
                Grid.RowSpan="2"
                MaxWidth="960"
                Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                extensions:Hairline.BorderThickness="1,0,1,1"/>

        <Border Grid.Row="1"
                Padding="{ThemeResource GenericPageHeaderMargin}"
                MaxWidth="960">
            <TextBlock Margin="12,4,12,12"
                       Text="CHATS"
                       Style="{ThemeResource BaseTextBlockStyle}"/>
        </Border>

        <mux:RefreshContainer Grid.Row="2"
                              RefreshRequested="OnRefreshRequested">
            <Grid MaxWidth="960"
                  x:Name="ChatLayout"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InboxColumn" Width="*"/>
                    <ColumnDefinition x:Name="ConversationColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="InboxPane"
                      BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                      extensions:Hairline.BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="16,16,16,8"
                               Text="Direct messages"
                               Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Grid Grid.Row="1"
                          Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.Recipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Handle or DID"
                                automation:AutomationProperties.Name="Chat recipient"/>
                        <Button Grid.Column="1"
                               Margin="8,0,0,0"
                               Content="New chat"
                               Command="{x:Bind ViewModel.StartConversationCommand}"
                               IsEnabled="{x:Bind ViewModel.CanStartConversation, Mode=OneWay}"
                               automation:AutomationProperties.Name="Start new chat"/>
                    </Grid>
                    <ListView x:Name="ConversationsList"
                              Grid.Row="3"
                              ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                              DisplayMemberPath="DisplayLabel"
                              SelectionChanged="ConversationsList_SelectionChanged"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              automation:AutomationProperties.Name="Direct message conversations">
                    </ListView>
                    <StackPanel Grid.Row="2"
                                Margin="16,0,16,8">
                        <TextBlock Text="Choose a follower"
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <ListView x:Name="FollowersList"
                                  ItemsSource="{x:Bind ViewModel.Followers, Mode=OneWay}"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="FollowersList_SelectionChanged"
                                  SelectionMode="Single"
                                  MaxHeight="180"
                                  automation:AutomationProperties.Name="Followers"/>
                        <Button Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                Content="Load more followers"
                                Click="LoadMoreFollowers_Click"
                                Visibility="{x:Bind ViewModel.HasMoreFollowers, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Row="4"
                            Margin="16,8"
                            HorizontalAlignment="Center"
                            Content="Load more"
                            Click="LoadMoreConversations_Click"
                            Visibility="{x:Bind ViewModel.HasMoreConversations, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>

                    <StackPanel Grid.Row="3"
                                Margin="24,64,24,0"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.IsConversationListEmpty, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                        <TextBlock Text="No direct messages yet"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0"
                                   Text="When an accepted one-to-one conversation starts, it will appear here."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ConversationPane"
                      Grid.Column="0"
                      Visibility="{x:Bind ViewModel.HasSelectedConversation, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,16,20,8">
                        <Button x:Name="BackToConversationsButton"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Content="Back to conversations"
                                Click="BackToConversations_Click"
                                Visibility="Visible"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedConversation.DisplayName, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Handle, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Margin="16,8"
                                HorizontalAlignment="Center"
                                Content="Load earlier messages"
                                Click="LoadMoreMessages_Click"
                                Visibility="{x:Bind ViewModel.HasMoreMessages, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                        <ListView x:Name="MessagesList"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                  ItemTemplate="{StaticResource ChatMessageTemplate}"
                                  SelectionMode="None"
                                  automation:AutomationProperties.Name="Messages">
                        </ListView>

                        <StackPanel Grid.Row="1"
                                    Margin="24,64,24,0"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind ViewModel.IsMessagesEmpty, Mode=OneWay, Converter={StaticResource VisibilityConverter}}">
                            <TextBlock Text="No messages yet"
                                       Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Margin="0,8,0,0"
                                       Text="Send a message to start this conversation."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2"
                          Padding="16"
                          Background="{ThemeResource GenericPageHeaderBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SendError, Mode=OneWay}"
                                      Margin="0,0,0,8"
                                      Foreground="{ThemeResource SystemErrorTextColor}"
                                      TextWrapping="Wrap"
                                      Visibility="{x:Bind ViewModel.SendError, Mode=OneWay, Converter={StaticResource VisibilityConverter}}"/>
                            <TextBox x:Name="MessageTextBox"
                                    Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Write a message"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MaxLength="10000"
                                    KeyDown="MessageTextBox_KeyDown"
                                    automation:AutomationProperties.Name="Message text"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Bottom"
                                Content="Send"
                                Command="{x:Bind ViewModel.SendCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                                automation:AutomationProperties.Name="Send message"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="32"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasSelectedConversation, Mode=OneWay, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="Select a conversation"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,8,0,0"
                               Text="Accepted one-to-one conversations are supported in this preview."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="320"/>
                </StackPanel>
            </Grid>
        </mux:RefreshContainer>

        <controls:LoadErrorControl Grid.Row="2"
                                   Title="Failed to load chats"
                                   Error="{x:Bind ViewModel.Error, Mode=OneWay}"
                                   RetryCommand="{x:Bind ViewModel.RefreshCommand}"/>

        <ProgressBar Grid.Row="2"
                     MaxWidth="960"
                     VerticalAlignment="Top"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Background="Transparent"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0"/>
                        <Setter Target="InboxColumn.Width" Value="*"/>
                        <Setter Target="ConversationColumn.Width" Value="0"/>
                        <Setter Target="ConversationPane.(Grid.Column)" Value="0"/>
                        <Setter Target="BackToConversationsButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0"/>
                        <Setter Target="InboxColumn.Width" Value="280"/>
                        <Setter Target="ConversationColumn.Width" Value="*"/>
                        <Setter Target="ConversationPane.(Grid.Column)" Value="1"/>
                        <Setter Target="BackToConversationsButton.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
